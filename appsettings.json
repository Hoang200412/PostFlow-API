{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=postflow_db;Username=postgres;Password=your_password"
  },
  "AllowedHosts": "*",
  "PlatformSettings": {
    "YouTube": {
      "ApplicationName": "PostFlow",
      "ClientId": "YOUR_YOUTUBE_CLIENT_ID",
      "ClientSecret": "YOUR_YOUTUBE_CLIENT_SECRET",
      "RefreshToken": "YOUR_YOUTUBE_REFRESH_TOKEN"
    },
    "TikTok": {
      "ClientKey": "YOUR_TIKTOK_CLIENT_KEY",
      "ClientSecret": "YOUR_TIKTOK_CLIENT_SECRET",
      "AccessToken": "YOUR_TIKTOK_ACCESS_TOKEN",
      "OpenId": "YOUR_TIKTOK_OPEN_ID"
    },
    "FacebookReels": {
      "AppId": "YOUR_FACEBOOK_APP_ID",
      "AppSecret": "YOUR_FACEBOOK_APP_SECRET",
      "PageId": "YOUR_FACEBOOK_PAGE_ID",
      "PageAccessToken": "YOUR_FACEBOOK_PAGE_ACCESS_TOKEN"
    }
  }
}
