@PostFlow_HostAddress = http://localhost:5042

### =================================================================
### 1. VIDEO ASSET MANAGEMENT (/api/videos)
### =================================================================

# Lấy danh sách video (Có phân trang)
GET {{PostFlow_HostAddress}}/api/videos?page=1&limit=10
Authorization: Bearer YOUR_JWT_TOKEN

###

# Lấy thông tin chi tiết một video theo ID
GET {{PostFlow_HostAddress}}/api/videos/YOUR_VIDEO_ID
Authorization: Bearer YOUR_JWT_TOKEN

###

# Cập nhật metadata video (Title, Description, Tags)
PUT {{PostFlow_HostAddress}}/api/videos/YOUR_VIDEO_ID
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN

{
  "title": "Tiêu đề video cập nhật",
  "description": "Mô tả chi tiết nội dung video",
  "tags": ["reels", "tiktok", "viral"]
}

###

# Xóa một video theo ID
DELETE {{PostFlow_HostAddress}}/api/videos/YOUR_VIDEO_ID
Authorization: Bearer YOUR_JWT_TOKEN

###

# Xóa hàng loạt video theo danh sách ID
DELETE {{PostFlow_HostAddress}}/api/videos/batch
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN

{
  "ids": ["VIDEO_ID_1", "VIDEO_ID_2"]
}

###

# Sinh video tự động bằng AI
POST {{PostFlow_HostAddress}}/api/videos/generate
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN

{
  "topic": "5 mẹo phát triển bản thân",
  "contentDnaId": "YOUR_DNA_ID",
  "channelIds": ["CHANNEL_ID_1"]
}

###

# Lấy Presigned URL để upload file video lớn
POST {{PostFlow_HostAddress}}/api/videos/presigned-upload
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN

{
  "filename": "my_video.mp4",
  "contentType": "video/mp4",
  "fileSize": 15000000
}

###

# Xác nhận hoàn tất upload video
POST {{PostFlow_HostAddress}}/api/videos/upload-confirm
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN

{
  "videoId": "YOUR_VIDEO_ID"
}


### =================================================================
### 2. PUBLISHING & SCHEDULING JOBS (/api/publishing-jobs)
### =================================================================

# Lấy danh sách các bài đăng / lịch đăng (Tùy chọn lọc status, channelId)
GET {{PostFlow_HostAddress}}/api/publishing-jobs
Authorization: Bearer YOUR_JWT_TOKEN

###

# Lấy chi tiết bài đăng / lịch đăng theo Job ID
GET {{PostFlow_HostAddress}}/api/publishing-jobs/YOUR_JOB_ID
Authorization: Bearer YOUR_JWT_TOKEN

###

# Khởi tạo bài đăng mới (Đăng ngay hoặc Hẹn giờ đăng)
POST {{PostFlow_HostAddress}}/api/publishing-jobs/enqueue
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN

{
  "videoAssetId": "YOUR_VIDEO_ASSET_ID",
  "socialAccountId": "YOUR_SOCIAL_ACCOUNT_ID",
  "scheduledAt": "2026-09-20T12:00:00Z"
}

###

# Cập nhật lịch đăng bài hoặc Metadata override
PUT {{PostFlow_HostAddress}}/api/publishing-jobs/YOUR_JOB_ID
Content-Type: application/json
Authorization: Bearer YOUR_JWT_TOKEN

{
  "scheduledAt": "2026-09-21T18:30:00Z"
}

###

# Hủy bài đăng đang chờ xử lý
DELETE {{PostFlow_HostAddress}}/api/publishing-jobs/YOUR_JOB_ID
Authorization: Bearer YOUR_JWT_TOKEN
